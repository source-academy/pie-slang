# Copy to .env.local (gitignored) and fill in. Vite bakes VITE_* vars into the
# frontend bundle at build time, so the tactic model works one-click with no
# manual entry in the AI Settings panel.
#
# LoRA tactic-prediction endpoint. Defaults to the Runpod serverless endpoint
# baked into the code (hint-store.ts), so VITE_LORA_SERVER_URL is optional.
VITE_LORA_SERVER_URL=https://api.runpod.ai/v2/<runpod-endpoint-id>
# Bearer token for the Runpod serverless endpoint (rpa_...). REQUIRED for the
# cloud endpoint; anyone with the built bundle can read it (it ships in the JS),
# so treat it as a shared, rotatable key scoped to this endpoint.
VITE_LORA_API_KEY=rpa_xxx

# Optional: Gemini API key for natural-language hint explanations.
VITE_GOOGLE_API_KEY=
