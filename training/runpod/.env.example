# Copy to .env and fill in before `flash deploy`.

# The private HuggingFace repo holding the LoRA adapter (adapter_config.json +
# adapter_model.safetensors + tokenizer files). Created by push-adapter.sh.
PIE_ADAPTER_REF=your-hf-username/pie-tactic-lora

# Base model — public/ungated 4-bit, no token needed. Leave as-is unless you
# vendor a different base.
PIE_BASE_MODEL=unsloth/qwen2.5-coder-7b-instruct-bnb-4bit

# HuggingFace token — REQUIRED because PIE_ADAPTER_REF is a PRIVATE repo.
# Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxx
