# Copy to .env.local (gitignored) and fill in to enable the LoRA tactic model.
# Vite bakes VITE_* vars into YOUR build at build time; nothing here is shipped
# unless you set it. The frontend hardcodes no endpoint or key — leaving these
# unset just disables LoRA hints (the DeepSeek explanation fallback still works).
#
# LoRA tactic-prediction endpoint (Runpod serverless). Not secret.
VITE_LORA_SERVER_URL=https://api.runpod.ai/v2/ogahfdvehdgq04
# Your Runpod Bearer token (rpa_...). Do NOT commit a real key. Note: whatever
# you put here is readable in the built JS bundle, so use a rotatable key
# scoped to this endpoint, not your primary account key.
VITE_LORA_API_KEY=

# Optional: DeepSeek API key for natural-language hint explanations.
VITE_DEEPSEEK_API_KEY=

# Optional: Cloudflare Worker that holds both keys server-side (see proxy/).
# For a public build, set this and VITE_LORA_SERVER_URL to the Worker URL and
# leave both key variables empty, so no key is shipped in the bundle.
VITE_GENERAL_LLM_PROXY_URL=
