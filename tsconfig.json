{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "target": "ES2020",
        "lib": ["ES2022", "DOM"],
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/language-server",
        "**/*.test.ts",
        "**/__tests__/**/*"
    ]
}
